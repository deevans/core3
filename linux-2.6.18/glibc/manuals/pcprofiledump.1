.TH PCPROFILEDUMP 1 "" "GNU Glibc" "Core Linux Distribution"

.SH NAME
pcprofiledump - dump information generated by PC profiling

.SH SYNOPSIS
.B pcprofiledump
[OPTION] [FILE]

.SH DESCRIPTION
Dump information generated by PC profiling.
.TP
.B -u, --unbuffered
don't buffer output
.TP
.B -?, --help
display help information
.TP
.B --usage
display usage information

