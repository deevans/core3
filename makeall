PKGs0="bash bin86 binutils bison bzip2 diffutils e2fsprogs file"
PKGs1=" fileutils findutils flex gawk gcc glibc grep groff gzip less"
PKGs2=" lilo m4 make man modutils nano nasm ncurses net-tools"
PKGs3=" netkit patch ppp procps psmisc sed shadow sh-utils sysklogd" 
PKGs4=" sysvinit tar texinfo textutils unzip util-linux wget which zip"

function build {
n=1 # Start exit at 2
for i in $*
do
	(echo "==== $i ===="; cd $i
	 sed -i '/^BIN_DATE/ cBIN_DATE=apr 23 2025$' *.info
		bash BUILD) \
			|| n="$(expr $n + 1)" exit $n
done
unset n i
}

build $PKGs{0..4}

