PKGs0="binutils glibc gcc bash bc bison bzip2 coreutils dev86 diffutils"
PKGs1=" e2fsprogs file findutils flex gawk gmp grep groff gzip"
PKGs2=" inetutils kmod less libpcap lilo linux m4 make man mktemp"
PKGs3=" mpfr mpc nano nasm ncurses net-tools openssl patch"
PKGs4=" pkg-config ppp procps-ng psmisc shadow sed sysklogd sysvinit"
PKGs5=" tack tar texinfo udev unzip util-linux-ng wget which xz zip"

function build {
n=1 # Start exit at 2
for i in $*
do
	(echo "==== $i ===="; cd $i
	 sed -i '/^BIN_DATE/ cBIN_DATE=aug 6 2025$' *.info
	 sed -i '/^COMPILE/ cCOMPILE=linux 4.20, glibc 2.28, gcc 7.5.0, binutils 2.31.1$' *.info
		bash BUILD) \
			|| n="$(expr $n + 1)" exit $n
done
unset n i
}

build $PKGs{0..5}

